# TaxiPay Backend Environment Variables

# If deployed on Railway in the same project, Railway sets DATABASE_URL automatically.
# If connecting from your local PC to Railway, use the Public TCP Proxy URL:
# (Find it in Railway: Postgres service -> Settings -> Networking -> Public Network)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Server Port (default 3000)
PORT=3000

# ---------------------------------------------------------------------------
# Seat QR signing
# ---------------------------------------------------------------------------
# The server signs every passenger payment link with this secret. Without it,
# /api/pay rejects everything, because an unsigned request can mark a seat paid.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_TOKEN_SECRET=

# How long a passenger QR stays valid (default 900 = 15 minutes)
QR_TOKEN_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Per-trip operator fee
# ---------------------------------------------------------------------------
FEE_PER_TRIP=5
SETTLEMENT_PAYEE_PHONE=0942927999

# ---------------------------------------------------------------------------
# One-time activation fee
#
# The driver app stays on a lock screen until this driver's row reaches
# 'approved'. Approved is only written after Telebirr confirms the payment
# (signature-verified callback, or queryOrder with a matching amount), or by the
# owner from the in-app admin screen.
# ---------------------------------------------------------------------------
ACCESS_FEE_AMOUNT=5

# Owner PIN for the in-app admin approve/revoke screen. Leave empty to disable
# those endpoints entirely. Never commit a real value.
ADMIN_PIN=

# Public HTTPS origin of this server. Used to build passenger QR links and the
# Telebirr notify_url. Telebirr will not call back an http:// or private address.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Telebirr (Ethio Telecom Fabric Payment Gateway)
# ---------------------------------------------------------------------------
# Until these are filled in, fees are recorded as 'pending' and never marked paid.
# Set to 'test' for the developer portal testbed, 'production' for live money.
TELEBIRR_ENVIRONMENT=test

# From developer.ethiotelecom.et. Issued as bare base64 DER with no BEGIN/END
# armour -- paste exactly as given, single line.
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY=
# Telebirr's public key, used to verify their callbacks and encrypt the token call.
TELEBIRR_PUBLIC_KEY=

# Required for the per-trip fee. This must be a contract with the mandate /
# direct-debit product enabled -- a plain BuyGoods contract cannot debit a
# driver wallet and will be rejected with code 60200098.
TELEBIRR_MANDATE_CONTRACT_NO=

TELEBIRR_ORDER_TIMEOUT=120m
TELEBIRR_TIMEOUT_SECONDS=30
